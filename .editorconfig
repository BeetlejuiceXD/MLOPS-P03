root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

# En Markdown, dos espacios al final de línea pueden ser un salto de línea a propósito.
[*.md]
trim_trailing_whitespace = false
